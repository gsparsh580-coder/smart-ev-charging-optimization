[
    {
        "id": "tab_smart_ev",
        "type": "tab",
        "label": "Smart EV Charging Optimizer",
        "disabled": false,
        "info": "Smart EV Charging Schedule Optimization Flow using HiveMQ MQTT"
    },
    {
        "id": "mqtt_broker_hivemq",
        "type": "mqtt-broker",
        "name": "HiveMQ Public Broker",
        "broker": "broker.hivemq.com",
        "port": "1883",
        "clientid": "NodeRED_SmartEV_Client",
        "autoConnect": true,
        "usetls": false,
        "compatmode": false,
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "ui_tab_ev",
        "type": "ui_tab",
        "name": "Smart EV Charging",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "ui_group_telemetry",
        "type": "ui_group",
        "name": "Live Sensor Telemetry",
        "tab": "ui_tab_ev",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui_group_controls",
        "type": "ui_group",
        "name": "Charging Station Controls",
        "tab": "ui_tab_ev",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui_group_schedule",
        "type": "ui_group",
        "name": "24-Hour Optimization & Cost",
        "tab": "ui_tab_ev",
        "order": 3,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "mqtt_in_telemetry",
        "type": "mqtt in",
        "z": "tab_smart_ev",
        "name": "HiveMQ: smart_ev/telemetry",
        "topic": "smart_ev/telemetry",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_hivemq",
        "x": 160,
        "y": 140,
        "wires": [["fn_parse_telemetry"]]
    },
    {
        "id": "mqtt_in_schedule",
        "type": "mqtt in",
        "z": "tab_smart_ev",
        "name": "HiveMQ: smart_ev/schedule",
        "topic": "smart_ev/schedule",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_hivemq",
        "x": 160,
        "y": 380,
        "wires": [["fn_parse_schedule"]]
    },
    {
        "id": "fn_parse_telemetry",
        "type": "function",
        "z": "tab_smart_ev",
        "name": "Extract Sensor Metrics",
        "func": "var data = msg.payload;\nvar msgSoc = { payload: data.battery_soc || 0 };\nvar msgPower = { payload: data.power_kw || 0 };\nvar msgCurrent = { payload: data.current || 0 };\nvar msgVoltage = { payload: data.voltage || 0 };\nvar msgTemp = { payload: data.temperature_c || 0 };\nvar msgRelay = { payload: data.relay_state === 'ON' };\n\nreturn [msgSoc, msgPower, msgCurrent, msgVoltage, msgTemp, msgRelay];",
        "outputs": 6,
        "x": 420,
        "y": 140,
        "wires": [
            ["gauge_soc"],
            ["gauge_power", "chart_power_live"],
            ["gauge_current"],
            ["gauge_voltage"],
            ["gauge_temperature"],
            ["switch_relay_state"]
        ]
    },
    {
        "id": "gauge_soc",
        "type": "ui_gauge",
        "z": "tab_smart_ev",
        "name": "Battery SoC",
        "group": "ui_group_telemetry",
        "order": 1,
        "width": 3,
        "height": 3,
        "gtype": "gage",
        "title": "Battery SoC",
        "label": "%",
        "format": "{{value}}%",
        "min": 0,
        "max": 100,
        "colors": ["#ca3838", "#e6e600", "#2ca02c"],
        "seg1": "20",
        "seg2": "80",
        "x": 700,
        "y": 60,
        "wires": []
    },
    {
        "id": "gauge_power",
        "type": "ui_gauge",
        "z": "tab_smart_ev",
        "name": "Charging Power",
        "group": "ui_group_telemetry",
        "order": 2,
        "width": 3,
        "height": 3,
        "gtype": "gage",
        "title": "Power",
        "label": "kW",
        "format": "{{value}} kW",
        "min": 0,
        "max": 11,
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "5",
        "seg2": "8",
        "x": 710,
        "y": 100,
        "wires": []
    },
    {
        "id": "gauge_current",
        "type": "ui_gauge",
        "z": "tab_smart_ev",
        "name": "Current",
        "group": "ui_group_telemetry",
        "order": 3,
        "width": 3,
        "height": 3,
        "gtype": "gage",
        "title": "Current",
        "label": "A",
        "format": "{{value}} A",
        "min": 0,
        "max": 32,
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "16",
        "seg2": "28",
        "x": 690,
        "y": 140,
        "wires": []
    },
    {
        "id": "gauge_voltage",
        "type": "ui_gauge",
        "z": "tab_smart_ev",
        "name": "Mains Voltage",
        "group": "ui_group_telemetry",
        "order": 4,
        "width": 3,
        "height": 3,
        "gtype": "gage",
        "title": "Voltage",
        "label": "V",
        "format": "{{value}} V",
        "min": 180,
        "max": 260,
        "colors": ["#ca3838", "#2ca02c", "#ca3838"],
        "seg1": "210",
        "seg2": "245",
        "x": 700,
        "y": 180,
        "wires": []
    },
    {
        "id": "gauge_temperature",
        "type": "ui_gauge",
        "z": "tab_smart_ev",
        "name": "Terminal Temp",
        "group": "ui_group_telemetry",
        "order": 5,
        "width": 6,
        "height": 2,
        "gtype": "donut",
        "title": "Contactor Temp",
        "label": "°C",
        "format": "{{value}} °C",
        "min": 10,
        "max": 80,
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "45",
        "seg2": "60",
        "x": 710,
        "y": 220,
        "wires": []
    },
    {
        "id": "chart_power_live",
        "type": "ui_chart",
        "z": "tab_smart_ev",
        "name": "Live Power Trend",
        "group": "ui_group_telemetry",
        "order": 6,
        "width": 6,
        "height": 3,
        "label": "Real-Time Charging Power (kW)",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "Waiting for live power stream...",
        "dot": false,
        "ymin": "0",
        "ymax": "8",
        "x": 710,
        "y": 260,
        "wires": [[], []]
    },
    {
        "id": "switch_relay_state",
        "type": "ui_switch",
        "z": "tab_smart_ev",
        "name": "Contactor Relay Switch",
        "label": "Contactor Relay (ON/OFF)",
        "tooltip": "Override EVSE contactor state",
        "group": "ui_group_controls",
        "order": 1,
        "width": 6,
        "height": 1,
        "passthru": false,
        "topic": "smart_ev/control",
        "onvalue": "true",
        "onvalueType": "bool",
        "onicon": "fa-toggle-on",
        "oncolor": "#28a745",
        "offvalue": "false",
        "offvalueType": "bool",
        "officon": "fa-toggle-off",
        "offcolor": "#dc3545",
        "x": 450,
        "y": 300,
        "wires": [["fn_format_control_cmd"]]
    },
    {
        "id": "fn_format_control_cmd",
        "type": "function",
        "z": "tab_smart_ev",
        "name": "Build Control Command",
        "func": "var isTrue = (msg.payload === true || msg.payload === 'true');\nmsg.payload = {\n    command: isTrue ? 'RELAY_ON' : 'RELAY_OFF',\n    state: isTrue ? 'ON' : 'OFF',\n    mode: 'MANUAL',\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "x": 720,
        "y": 300,
        "wires": [["mqtt_out_control"]]
    },
    {
        "id": "mqtt_out_control",
        "type": "mqtt out",
        "z": "tab_smart_ev",
        "name": "HiveMQ: smart_ev/control",
        "topic": "smart_ev/control",
        "qos": "1",
        "retain": false,
        "broker": "mqtt_broker_hivemq",
        "x": 980,
        "y": 300,
        "wires": []
    },
    {
        "id": "fn_parse_schedule",
        "type": "function",
        "z": "tab_smart_ev",
        "name": "Process Schedule & Savings",
        "func": "var s = msg.payload;\nvar comp = s.comparison || {};\nvar opt = s.optimized || {};\nvar un = s.uncontrolled || {};\n\nvar htmlCard = '<div style=\"padding:12px; background:#1e293b; color:#fff; border-radius:8px; font-family:sans-serif;\">' +\n  '<h3 style=\"color:#38bdf8; margin-top:0;\">Smart Optimization Cost Savings</h3>' +\n  '<p><b>Uncontrolled Cost:</b> ₹' + (un.total_cost || 0) + '</p>' +\n  '<p><b>Optimized Cost:</b> ₹' + (opt.total_cost || 0) + '</p>' +\n  '<h2 style=\"color:#4ade80;\">Savings: ₹' + (comp.cost_savings || 0) + ' (' + (comp.savings_percent || 0) + '%)</h2>' +\n  '<p><b>CO2 Avoided:</b> ' + (comp.co2_saved_kg || 0) + ' kg</p>' +\n  '</div>';\n\nvar msgHtml = { payload: htmlCard };\nreturn msgHtml;",
        "outputs": 1,
        "x": 430,
        "y": 380,
        "wires": [["ui_template_savings"]]
    },
    {
        "id": "ui_template_savings",
        "type": "ui_template",
        "z": "tab_smart_ev",
        "group": "ui_group_schedule",
        "name": "Cost Savings Card",
        "order": 1,
        "width": 12,
        "height": 4,
        "format": "<div ng-bind-html=\"msg.payload\"></div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 710,
        "y": 380,
        "wires": [[]]
    }
]
